PORT=1500

# Uncomment and set the path to your Chromium executable if Playwright's bundled one is not installed
# BROWSER_PATH=/home/container/chrome-linux/chrome

# Access control (optional)
# When set, clients must send the key: `Authorization: Bearer <key>`, `X-API-Key: <key>` or `?key=<key>`. /health stays public.
# API_KEY=
# Requests per minute and per IP, 0 = no limit
# RATE_LIMIT_PER_MINUTE=0
# Read the client IP from X-Forwarded-For / X-Real-IP. Only enable behind a reverse proxy, anyone can send these headers otherwise.
# TRUST_PROXY=false

# Spotify lyrics (optional): the sp_dc cookie of a Spotify account, from open.spotify.com while logged in.
# Spotify only serves lyrics to logged-in users. Use a separate account, not your personal one.
# Free accounts work, but Spotify may cap their lyrics per month: prefer a Premium account if you rely on lyrics.
# SPOTIFY_SP_DC=

# Cache (optional)
# CACHE_DIR=cache
# Total size of the JSON kept in memory, all caches together
# CACHE_MEMORY_MAX_MB=200
# CACHE_MEMORY_TTL_HOURS=12
# Disk cache lifetime, 0 = never expires
# CACHE_DISK_TTL_HOURS=24

# Country code (e.g. FR) for the /full routes: tracks get `is_playable` instead of the long `available_markets` list (optional)
# SPOTIFY_MARKET=

# Persisted query hashes of the Spotify web player (optional).
# Only needed when Spotify rotates them and playlists or recommendations start failing with a 502.
# SPOTIFY_PLAYLIST_HASH=
# SPOTIFY_RECOMMENDATIONS_HASH=
