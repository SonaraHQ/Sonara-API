{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "strict": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true,
        "types": [
        "node"
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "paths": {
            "@/*": ["./src/*"]
        },
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src"]
}