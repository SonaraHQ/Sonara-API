{
    "name": "hfy",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit",
        "format": "biome check --write ./src"
    },
    "dependencies": {
        "@biomejs/biome": "^2.5.8",
        "@hono/node-server": "^2.1.1",
        "dotenv": "^17.4.2",
        "hono": "^4.13.2",
        "lru-cache": "^11.5.2",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.12"
    }
}