{
    "name": "sonara-api",
    "version": "1.2.0",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit && tsc -p test",
        "test": "vitest run",
        "lint": "biome check",
        "format": "biome check --write",
        "start:prod": "node dist/index.js",
        "install:browser": "playwright install chromium"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "hono": "^4.13.14",
        "lru-cache": "^11.5.3",
        "playwright": "^1.64.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@types/node": "^24.19.2",
        "tsc-alias": "^1.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "description": "Spotify resolver API (playlists, recommendations, lyrics) with built-in anonymous token generation (Playwright)"
}
