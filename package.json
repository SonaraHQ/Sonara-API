{
    "name": "sonara-api",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "tsc && tsc-alias",
        "typecheck": "tsc --noEmit",
        "format": "biome check --write ./src",
        "start:prod": "node dist/index.js",
        "install:browser": "playwright install chromium"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "hono": "^4.13.14",
        "lru-cache": "^11.5.3",
        "playwright": "^1.64.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@types/node": "^26.6.5",
        "tsc-alias": "^1.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "description": "Spotify resolver (playlists, recommendations) with built-in anonymous token generation (Playwright)"
}
